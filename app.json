{
  "expo": {
    "name": "barber-app",
    "slug": "barber-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "barberapp",
    "userInterfaceStyle": "automatic",
    "ios": { "supportsTablet": true },
    "android": { "adaptiveIcon": { "backgroundColor": "#E6F4FE" } },
    "web": { "bundler": "metro" }, 
    "plugins": [
      [
        "expo-splash-screen",
        { "image": "./assets/images/splash-icon.png", "backgroundColor": "#ffffff" }
      ]
    ]
  }
}